# Server Configuration
PORT=8000
FRONTEND_URL=http://localhost:5173
# Allowed CORS Origins (comma-separated; in dev, http://localhost:5173 and desktop origins are allowed by default)
ALLOWED_ORIGINS=http://localhost:5173,http://tauri.localhost,https://tauri.localhost

# Rate Limiting Configuration (In-memory store, local development)
RATE_LIMIT_GUEST_WINDOW_MS=900000
RATE_LIMIT_GUEST_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# Database Connection
MONGODB_URI=mongodb://localhost:27017/alfred

# Authentication Security
JWT_SECRET=your-secure-jwt-secret-here
