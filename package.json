{
  "name": "alfred-frontend",
  "private": true,
  "version": "0.1.0-beta.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:development": "tsc -b && vite build --mode development",
    "test:production-simulator": "npm run build && node scripts/verify-production-simulator.ts",
    "test:reliability-ui": "node scripts/verify-reliability-ui.ts",
    "test:updates-ui": "node scripts/verify-update-ui.ts",
    "test:startup-ui": "node scripts/verify-startup-ui.ts",
    "test:overlay-lifecycle": "node scripts/verify-overlay-lifecycle.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "release:windows": "node scripts/release-windows.js",
    "dev:pc": "node scripts/dev-pc.js",
    "dev:android": "node scripts/dev-android.js",
    "android:sync-assistant": "node scripts/sync-android-assistant.js",
    "test:android-assistant": "node --test scripts/tests/android-assistant.test.ts",
    "android:build-assistant": "node scripts/build-android-assistant.js",
    "dev:backend": "node scripts/dev-backend.js",
    "dev:ngrok": "npm run dev:backend",
    "dev:all": "concurrently -k --kill-others -n backend,tauri -c magenta,blue \"npm --prefix Alfred_Backend run dev\" \"npm run tauri:dev\"",
    "test": "node --test scripts/tests/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/cors": "^2.8.19",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "^21.0.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
